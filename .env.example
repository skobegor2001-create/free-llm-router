# ============================================================
#  Free LLM Router — конфигурация
#  Впишите один или несколько ключей. Пустые строки = выключено.
#  Все ключи бесплатные, карта не нужна.
# ============================================================

# Groq — очень быстрый, gpt-oss-120b / qwen3.8-27b
# https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — самая щедрая квота: ~1 млн токенов в день
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Google Gemini — бесплатный тир AI Studio
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — десятки :free-моделей (50 запросов/день)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral — Experiment plan (без карты, нужен телефон)
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Порядок автопереключения (слева направо). Можно менять.
PROVIDER_ORDER=groq,cerebras,gemini,openrouter,mistral

# Порт веб-чата и OpenAI-шлюза
PORT=8000

# Интерфейс: 127.0.0.1 — только этот компьютер (безопасно, по умолчанию для установщика).
# 0.0.0.0 — доступ из локальной сети (тогда включите аутентификацию на шлюзе).
HOST=127.0.0.1

# ---- Индекс PDF в SQLite (необязательно) ----
# Путь к вашей базе. Схема определяется автоматически (FTS5 или обычные таблицы).
# INDEX_DB=C:\path\to\index.db
# Если автоопределение ошибается — укажите явно:
# INDEX_TABLE=chunks
# INDEX_TEXT_COL=content
# INDEX_DOC_COL=file
# INDEX_PAGE_COL=page
